# ---------------------------------------------------------------------------
# code-trust environment template. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# AWS target (infra takes its region from infra/lib/config.ts, not from here)
AWS_REGION=ap-south-1

# Neon Postgres (external, free tier, NOT RDS)
DATABASE_URL=postgres://user:password@host.neon.tech/code_trust?sslmode=require

# GitHub App (used by the webhook Lambda + Fargate git workers, later tasks)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Budget alerts. Required for every cdk command except `pnpm synth`; the REPLACE_ME value is rejected.
ALERT_EMAIL=REPLACE_ME@example.com
