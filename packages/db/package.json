{
  "name": "@code-trust/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres schema, migrations and typed queries.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./neon": "./src/neon.ts",
    "./pg": "./src/pg.ts",
    "./testing": "./src/testing.ts",
    "./testing-neon": "./src/testing-neon.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "migrate": "node --experimental-strip-types --env-file-if-exists=../../.env.workspace src/migrate.ts"
  },
  "dependencies": {
    "@code-trust/shared": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
