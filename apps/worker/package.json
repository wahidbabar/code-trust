{
  "name": "@code-trust/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Job runner around the analyzer: clone, analyze, write results.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "run-job": "node --experimental-strip-types --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env.workspace src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1145.0",
    "@code-trust/analyzer": "workspace:*",
    "@code-trust/db": "workspace:*",
    "@code-trust/shared": "workspace:*",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
