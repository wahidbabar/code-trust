{
  "name": "@code-trust/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS REST API on Lambda.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=../../.env.workspace --import tsx src/main.ts",
    "seed": "node --experimental-strip-types --env-file-if-exists=../../.env.workspace src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1145.0",
    "@code-trust/db": "workspace:*",
    "@code-trust/shared": "workspace:*",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
